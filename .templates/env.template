# IMMICH
###############################################
IMMICH_DB_USERNAME=<your_immich_db_user>
IMMICH_DB_PASSWORD=<your_immich_db_password>

###############################################
# MEMOS
###############################################
MEMOS_DB_USERNAME=<your_memos_db_user>
MEMOS_DB_PASSWORD=<your_memos_db_password>

