################################################
# OUTLINE
################################################
OUTLINE_SECRET_KEY=your-outline-secret-key
OUTLINE_DB_USERNAME=your-db-username
OUTLINE_DB_PASSWORD=your-db-password
OUTLINE_OIDC_CLIENT_SECRET=your-oidc-client-secret
OUTLINE_OIDC_AUTH_URI=https://your-auth-domain.example.com/api/oidc/authorization
OUTLINE_OIDC_TOKEN_URI=https://your-auth-domain.example.com/api/oidc/token
