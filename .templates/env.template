################################################
#
# Please edit this file and enter your info
# into the <placeholders> below
#
################################################

# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#Time_Zone_abbreviations
# choose a value from the TZ database name column on the wikipedia page above
TZ=<your_timezone>
HOST_NAME=<your_host_name>
HOST_DOMAIN=<your_host_domain>

# Storage is split by workload, so the two directories can live on different pools:
#   DOCKERDIR - application state and databases. Small, latency-sensitive and
#               lock-sensitive (Postgres/MySQL/Mongo/SQLite): put it on fast
#               storage (SSD/NVMe).
#   DATADIR   - bulk data (media, photos, documents, downloads). Large and mostly
#               sequential: high-capacity storage (HDD) is fine.
#               Immich's photo library lives at ${DATADIR}/immich.
DOCKERDIR=<your_docker_directory>
DATADIR=<your_data_directory>

BOOKS_DIR=<your_data_directory>
SHOWS_DIR=<your_data_directory>
MUSIC_DIR=<your_data_directory>
MOVIES_DIR=<your_data_directory>
MISC_DIR=<your_data_directory>
CLASSES_DIR=<your_data_directory>

###############################################
# CLOUDFLARE
###############################################
CLOUDFLARE_DNS_EMAIL=<your_cloudflare_email>
CLOUDFLARE_DNS_API_TOKEN=<your_cloudflare_api_token>

###############################################
# N8N
###############################################
N8N_ENCRYPTION_KEY=<your_n8n_encryption_key>  # openssl rand -base64 32

###############################################
# NEXTCLOUD
###############################################
NEXTCLOUD_SMTP_NAME=<your_smtp_email>
NEXTCLOUD_SMTP_PASSWORD=<your_smtp_password>

NEXTCLOUD_ADMIN_USER=<your_nextcloud_admin_user>
NEXTCLOUD_ADMIN_PASSWORD=<your_nextcloud_admin_password>

NEXTCLOUD_DB_USER=<your_nextcloud_db_user>
NEXTCLOUD_DB_PASSWORD=<your_nextcloud_db_password>

###############################################
# GARAGE (S3 storage)
###############################################
GARAGE_RPC_SECRET=<your_garage_rpc_secret>            # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=<your_garage_admin_token>          # openssl rand -base64 32
GARAGE_METRICS_TOKEN=<your_garage_metrics_token>      # openssl rand -base64 32
GARAGE_DEFAULT_ACCESS_KEY=<your_garage_access_key>    # GK$(openssl rand -hex 16)
GARAGE_DEFAULT_SECRET_KEY=<your_garage_secret_key>    # openssl rand -hex 32
GARAGE_DEFAULT_BUCKET=default-bucket


###############################################
# Sharelatex
###############################################
SHARELATEX_ROOT_EMAIL=<your_sharelatex_root_email>

###############################################
# Monitoring
###############################################
GRAFANA_USER=<your_grafana_user>
GRAFANA_PASSWORD=<your_grafana_password>

###############################################
# WORDPRESS
###############################################
WORDPRESS_DB_NAME=<your_wordpress_db_name>
WORDPRESS_DB_USER=<your_wordpress_db_user>
WORDPRESS_DB_PASSWORD=<your_wordpress_db_password>
WORDPRESS_DB_ADMIN_PASSWORD=<your_wordpress_db_admin_password>

WORDPRESS_ADMIN_NAME=<your_admin_first_name>
WORDPRESS_ADMIN_LASTNAME=<your_admin_last_name>
WORDPRESS_ADMIN_USERNAME=<your_admin_username>
WORDPRESS_ADMIN_EMAIL=<your_admin_email>
WORDPRESS_ADMIN_PASSWORD=<your_admin_password>

# not used
WORDPRESS_TABLE_PREFIX=wpapp_
WORDPRESS_BLOG_NAME='<your_blog_name>'

WORDPRESS_SMTP_ADDRESS=<your_smtp_address>
WORDPRESS_SMTP_PORT=<your_smtp_port>
WORDPRESS_SMTP_USER_NAME=<your_smtp_user_name>
WORDPRESS_SMTP_PASSWORD=<your_smtp_password>

###############################################
# PENPOT
###############################################
# Master key both the backend and the exporter derive from - they must match.
# Leave it unset and the backend regenerates one per restart (invalidating all
# sessions) while the exporter refuses to start at all.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=<your_penpot_secret_key>

